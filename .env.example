# ABA Connect — environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (local dev defaults are printed by `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for Drive webhooks, cron jobs, etc.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) — PHI-free content only ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@autismbrightstart.org

# --- Google Drive / Workspace OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Signs OAuth state params (falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
INTEGRATION_OAUTH_SECRET=
# Base URL Google uses for Drive "watch" push notifications (must be https in prod)
DRIVE_WEBHOOK_BASE_URL=

# --- DocSeal (e-signatures) — stubbed when unset ---
DOCSEAL_API_KEY=
DOCSEAL_BASE_URL=https://api.docseal.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin signup (auth page) ---
# When true, the login page shows a Sign up tab for new admin accounts.
# Set to false in production once invite-only flow is enabled in Settings.
ALLOW_ADMIN_SIGNUP=true
# Optional: restrict signup to a single email domain (e.g. autismbrightstart.org)
ADMIN_SIGNUP_EMAIL_DOMAIN=autismbrightstart.org
